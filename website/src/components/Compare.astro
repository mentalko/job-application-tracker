---
// The README's comparison, as a table. "yes" / "no" render as marks; anything else as text.
const rows: [string, string, string, string][] = [
  ["Your data stays on your machine", "Sometimes", "no", "yes"],
  ["Recruiters with several roles", "Manual", "Partial", "First-class"],
  ["Real stage workflow and history", "no", "Partial", "yes"],
  ["Notes, files, emails and CV versions", "Messy", "Partial", "yes"],
  ['"Who do I chase today?"', "no", "Partial", "yes"],
  ["Free and open source", "yes", "no", "Apache-2.0"],
];
const mark = (v: string) => (v === "yes" ? "✓" : v === "no" ? "✕" : v);
const cls = (v: string) => (v === "yes" ? "yes" : v === "no" ? "no" : "txt");
---

<section class="section" aria-labelledby="compare-h">
  <div class="wrap">
    <div class="center head">
      <p class="eyebrow reveal">Why not a spreadsheet?</p>
      <h2 class="h2 reveal" id="compare-h">Spreadsheets don't <span class="serif grad">nudge</span> you.</h2>
      <p class="lede reveal">
        And hosted trackers want your data, your email and a subscription. This one wants nothing.
      </p>
    </div>

    <div class="card table-card reveal">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            <th scope="col">Spreadsheet or Notion</th>
            <th scope="col">Hosted trackers (Huntr, Teal…)</th>
            <th scope="col" class="us">Job Application Tracker</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map(([label, a, b, c]) => (
              <tr>
                <th scope="row">{label}</th>
                <td class={cls(a)}>{mark(a)}</td>
                <td class={cls(b)}>{mark(b)}</td>
                <td class={`us ${cls(c)}`}>
                  {c === "yes" ? "✓" : `✓ ${c}`}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="note reveal">
      It's also deliberately <strong>not</strong> a job-search engine: no scraping, no job-board feeds. It
      tracks the applications <em>you</em> make.
    </p>
  </div>
</section>

<style>
  .head {
    margin-bottom: 56px;
  }
  .table-card {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
    font-size: 16px;
  }
  th,
  td {
    padding: 18px 22px;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    vertical-align: bottom;
  }
  tbody th {
    text-align: left;
    font-weight: 500;
  }
  td {
    color: var(--muted);
  }
  .no {
    color: #ff8787;
    font-size: 18px;
  }
  .yes {
    color: var(--green);
    font-size: 18px;
  }
  .us {
    background: linear-gradient(180deg, rgb(92 124 250 / 0.14), rgb(132 94 247 / 0.1));
    color: #b2f2bb;
    font-weight: 600;
  }
  thead .us {
    color: var(--text);
    font-size: 15px;
  }
  tbody tr {
    transition: background 0.2s;
  }
  tbody tr:hover {
    background: var(--surface);
  }
  .note {
    text-align: center;
    color: var(--muted);
    margin: 28px auto 0;
    max-width: 640px;
  }
</style>
