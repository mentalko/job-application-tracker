---
// The README's comparison, as a table. "yes" / "no" render as marks; anything else as text.
const rows: [string, string, string, string][] = [
  ["Your data stays on your computer", "Sometimes", "no", "yes"],
  ["No account or sign-up", "no", "no", "yes"],
  ["No tracking or ads", "no", "no", "yes"],
  ["No AI reading your data", "Depends", "no", "yes"],
  ["Recruiters with several roles", "Manual", "Partial", "First-class"],
  ["Real stage workflow and history", "no", "Partial", "yes"],
  ["Notes, files, emails and CV versions", "Messy", "Partial", "yes"],
  ['"Who do I chase today?"', "no", "Partial", "yes"],
  ["Free", "yes", "Paid plans", "Free and open source"],
];
const mark = (v: string) => (v === "yes" ? "✓" : v === "no" ? "✕" : v);
const cls = (v: string) => (v === "yes" ? "yes" : v === "no" ? "no" : "txt");
---

<section class="section" aria-labelledby="compare-h">
  <div class="wrap">
    <div class="center head">
      <p class="eyebrow reveal">A free Huntr and Teal alternative</p>
      <h2 class="h2 reveal" id="compare-h">
        Better than a spreadsheet, <span class="serif grad">kinder</span> than a subscription.
      </h2>
      <p class="lede reveal">
        Spreadsheets don't remind you who to chase. Hosted trackers want your data, your email and a
        subscription. This one wants nothing.
      </p>
    </div>

    <div class="card table-card reveal">
      <table>
        <thead>
          <tr>
            <th scope="col">
              <span class="sr-only">Feature</span>
            </th>
            <th scope="col">Spreadsheet or Notion</th>
            <th scope="col">Hosted trackers (Huntr, Teal…)</th>
            <th scope="col" class="us">
              Job Application Tracker
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map(([label, a, b, c]) => (
            <tr>
              <th scope="row">{label}</th>
              <td class={cls(a)}>{mark(a)}</td>
              <td class={cls(b)}>{mark(b)}</td>
              <td class={`us ${cls(c)}`}>{c === "yes" ? "✓" : `✓ ${c}`}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note reveal">
      It's also deliberately <strong>not</strong> a job-search engine: no scraping, no job-board feeds. It
      tracks the applications <em>you</em> make.
    </p>
  </div>
</section>

<style>
  .head {
    margin-bottom: 56px;
  }
  .table-card {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
    font-size: 16px;
  }
  th,
  td {
    padding: 18px 22px;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    vertical-align: bottom;
  }
  tbody th {
    text-align: left;
    font-weight: 500;
  }
  /* On a phone the table scrolls sideways; the row labels stay put. */
  @media (max-width: 700px) {
    tbody th,
    thead th:first-child {
      position: sticky;
      left: 0;
      z-index: 1;
      background: var(--bg-2);
      min-width: 150px;
      box-shadow: 8px 0 16px -8px color-mix(in oklab, var(--shadow) 80%, transparent);
    }
  }
  td {
    color: var(--muted);
  }
  .no {
    color: var(--no);
    font-size: 18px;
  }
  .yes {
    color: var(--green);
    font-size: 18px;
  }
  .us {
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--brand) 14%, transparent),
      color-mix(in oklab, var(--violet) 10%, transparent)
    );
    color: var(--green);
    font-weight: 600;
  }
  thead .us {
    color: var(--text);
    font-size: 15px;
  }
  tbody tr {
    transition: background 0.2s;
  }
  tbody tr:hover {
    background: var(--surface);
  }
  .note {
    text-align: center;
    color: var(--muted);
    margin: 28px auto 0;
    max-width: 640px;
  }
</style>
