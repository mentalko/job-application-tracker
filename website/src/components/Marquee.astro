---
import { MARQUEE } from "../data";
---

<section class="marquee" aria-label="What's inside">
  {
    MARQUEE.map((row, r) => (
      <div class={`row ${r % 2 ? "rev" : ""}`}>
        {[0, 1].map((copy) => (
          <ul aria-hidden={copy === 1 ? "true" : undefined}>
            {row.map((item) => (
              <li>
                <span class="spark">✦</span>
                {item}
              </li>
            ))}
          </ul>
        ))}
      </div>
    ))
  }
</section>

<style>
  .marquee {
    padding-block: 70px 10px;
    display: grid;
    gap: 16px;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .row {
    display: flex;
    overflow: hidden;
  }
  ul {
    display: flex;
    flex: none;
    gap: 16px;
    padding: 0 16px 0 0;
    margin: 0;
    list-style: none;
    animation: slide 40s linear infinite;
  }
  .rev ul {
    animation-direction: reverse;
    animation-duration: 46s;
  }
  .marquee:hover ul {
    animation-play-state: paused;
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 22px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 17px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--muted);
  }
  .spark {
    color: var(--violet);
    font-size: 12px;
  }
  @keyframes slide {
    to {
      transform: translateX(-100%);
    }
  }
</style>
