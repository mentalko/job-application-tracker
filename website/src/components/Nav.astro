---
import Logo from "./Logo.astro";
import { REPO } from "../data";

interface Props {
  stars: number | null;
}
const { stars } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="nav">
  <nav class="wrap nav-inner" aria-label="Main">
    <a class="brand" href={base} aria-label="Job Application Tracker, home">
      <Logo size={30} />
      <span>Job Application Tracker</span>
    </a>
    <div class="links">
      <a href="#features">Features</a>
      <a href="#how">How it works</a>
      <a href="#quickstart">Quick start</a>
      <a href={`${base}docs/`}>Docs</a>
    </div>
    <a class="star" href={REPO} data-magnetic>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
      <span>Star</span>
      {stars !== null && stars >= 10 && <b>{stars.toLocaleString("en")}</b>}
    </a>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      background 0.4s,
      border-color 0.4s,
      backdrop-filter 0.4s;
    border-bottom: 1px solid transparent;
  }
  .nav:global(.scrolled) {
    background: rgb(5 6 15 / 0.62);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom-color: var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  .links {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .links a {
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .links a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .star {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition:
      transform 0.4s var(--ease),
      background 0.2s;
  }
  .star:hover {
    background: var(--surface-2);
  }
  .star b {
    padding-left: 8px;
    border-left: 1px solid var(--border-strong);
    font-weight: 600;
    color: var(--amber);
  }
  @media (max-width: 860px) {
    .links {
      display: none;
    }
    .star {
      margin-left: auto;
    }
  }
  @media (max-width: 420px) {
    .brand span {
      display: none;
    }
  }
</style>
