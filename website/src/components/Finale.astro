---
import Logo from "./Logo.astro";
import { REPO } from "../data";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<section class="finale" aria-labelledby="finale-h">
  <div class="wrap center">
    <div class="orb" aria-hidden="true"></div>
    <h2 class="big reveal" id="finale-h">
      Your next offer is <span class="serif grad">in there somewhere.</span>
    </h2>
    <p class="lede reveal">Clone it, run it, and never lose track of a recruiter again.</p>
    <div class="ctas reveal">
      <a class="btn btn-primary" href={`${base}docs/install/`} data-magnetic>
        Get started <span class="arrow">→</span>
      </a>
      <a class="btn btn-ghost" href={REPO} data-magnetic>
        View on GitHub
      </a>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap foot-inner">
    <div class="brand">
      <Logo size={26} />
      <div>
        <b>Job Application Tracker</b>
        <small>Open source · self-hosted · local-first</small>
      </div>
    </div>
    <nav aria-label="Footer">
      <div>
        <h3>Product</h3>
        <a href="#features">Features</a>
        <a href="#how">How it works</a>
        <a href="#quickstart">Quick start</a>
        <a href="#faq">FAQ</a>
      </div>
      <div>
        <h3>Docs</h3>
        <a href={`${base}docs/install/`}>Install</a>
        <a href={`${base}docs/your-data/`}>Your data</a>
        <a href={`${base}docs/using-the-app/`}>Using the app</a>
        <a href={`${base}docs/commands/`}>Commands</a>
      </div>
      <div>
        <h3>Project</h3>
        <a href={REPO}>GitHub</a>
        <a href={`${REPO}/issues`}>Issues</a>
        <a href={`${base}docs/contributing/`}>Contributing</a>
        <a href={`${base}docs/changelog/`}>Changelog</a>
      </div>
    </nav>
  </div>
  <div class="wrap legal">
    <span>
      © {year} Kai Waddington · <a href={`${REPO}/blob/main/LICENSE`}>Apache-2.0</a>
    </span>
    <span>Screenshots show made-up demo data. No cookies, no analytics.</span>
  </div>
</footer>

<style>
  .finale {
    position: relative;
    padding-block: clamp(120px, 16vw, 200px);
  }
  .orb {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(760px, 90vw);
    height: min(760px, 90vw);
    translate: -50% -50%;
    border-radius: 50%;
    background: conic-gradient(from var(--angle), #4c6ef5, #845ef7, #f06595, #3bc9db, #4c6ef5);
    filter: blur(140px);
    opacity: 0.28;
    animation: spin 14s linear infinite;
    z-index: -1;
  }
  .big {
    font-size: clamp(44px, 8vw, 110px);
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 700;
    margin: 0 auto 24px;
    max-width: 1000px;
    text-wrap: balance;
  }
  .ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 36px;
  }
  .foot {
    border-top: 1px solid var(--border);
    background: rgb(5 6 15 / 0.7);
    backdrop-filter: blur(10px);
  }
  .foot-inner {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding-block: 56px 36px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .brand b {
    display: block;
  }
  .brand small {
    color: var(--faint);
  }
  nav {
    display: flex;
    gap: 64px;
    flex-wrap: wrap;
  }
  nav div {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  h3 {
    margin: 0 0 4px;
    font-size: 13px;
    font-family: var(--mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
  }
  nav a:hover {
    color: var(--text);
  }
  .legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    padding-block: 22px 34px;
    border-top: 1px solid var(--border);
    font-size: 13.5px;
    color: var(--faint);
  }
  .legal a {
    color: var(--muted);
  }
</style>
