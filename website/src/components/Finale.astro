---
import Logo from "./Logo.astro";
import { GUIDE, REPO } from "../data";

const year = new Date().getFullYear();
---

<section class="finale" aria-labelledby="finale-h">
  <div class="wrap center">
    <div class="orb" aria-hidden="true"></div>
    <h2 class="big reveal" id="finale-h">
      Your next offer is <span class="serif grad">in there somewhere.</span>
    </h2>
    <p class="lede reveal">
      Set it up once, and never lose track of a recruiter, an interview or a follow-up again.
    </p>
    <div class="ctas reveal">
      <a class="btn btn-primary" href={`${GUIDE}install.md`} data-magnetic>
        Get started <span class="arrow">→</span>
      </a>
      <a class="btn btn-ghost" href={REPO} data-magnetic>
        View on GitHub
      </a>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap foot-inner">
    <div class="brand">
      <Logo size={26} />
      <div>
        <b>Job Application Tracker</b>
        <small>Free · private · open source</small>
      </div>
    </div>
    <nav aria-label="Footer">
      <div>
        <h2>Product</h2>
        <a href="#features">Features</a>
        <a href="#how">How it works</a>
        <a href="#quickstart">Quick start</a>
        <a href="#faq">FAQ</a>
      </div>
      <div>
        <h2>Docs</h2>
        <a href={`${GUIDE}install.md`}>Install</a>
        <a href={`${GUIDE}your-data.md`}>Your data</a>
        <a href={`${GUIDE}using-the-app.md`}>Using the app</a>
        <a href={`${GUIDE}commands.md`}>Commands</a>
      </div>
      <div>
        <h2>Project</h2>
        <a href={REPO}>GitHub</a>
        <a href={`${REPO}/issues`}>Issues</a>
        <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Contributing</a>
        <a href={`${REPO}/blob/main/CHANGELOG.md`}>Changelog</a>
      </div>
    </nav>
  </div>
  <div class="wrap legal">
    <span>
      © {year} Kai Waddington · <a href={`${REPO}/blob/main/LICENSE`}>Apache-2.0</a>
    </span>
    <span>
      Screenshots show made-up demo data. Hosted on GitHub Pages; this site adds no cookies, analytics or
      trackers.
    </span>
  </div>
</footer>

<style>
  .finale {
    position: relative;
    padding-block: clamp(120px, 16vw, 200px);
  }
  .orb {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(760px, 90vw);
    height: min(760px, 90vw);
    translate: -50% -50%;
    border-radius: 50%;
    background: conic-gradient(
      from var(--angle),
      var(--brand),
      var(--violet),
      var(--pink),
      var(--cyan),
      var(--brand)
    );
    filter: blur(140px);
    opacity: 0.28;
    animation: spin 14s linear infinite;
    z-index: -1;
  }
  .big {
    font-size: clamp(44px, 8vw, 110px);
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 700;
    margin: 0 auto 24px;
    max-width: 1000px;
    text-wrap: balance;
  }
  .ctas {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 36px;
  }
  .foot {
    border-top: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    backdrop-filter: blur(10px);
  }
  .foot-inner {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding-block: 56px 36px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .brand b {
    display: block;
  }
  .brand small {
    color: var(--faint);
  }
  nav {
    display: flex;
    gap: 64px;
    flex-wrap: wrap;
  }
  nav div {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  nav h2 {
    margin: 0 0 4px;
    font-size: 13px;
    font-family: var(--mono);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
  }
  nav a:hover {
    color: var(--text);
  }
  .legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    padding-block: 22px 34px;
    border-top: 1px solid var(--border);
    font-size: 13.5px;
    color: var(--faint);
  }
  .legal a {
    color: var(--muted);
  }
</style>
