---
import { Image } from "astro:assets";
import { REPO, ROTATING } from "../data";
import { shot } from "../shots";
---

<section class="hero">
  <div class="wrap hero-text">
    <a class="pill reveal" href={`${REPO}/blob/main/CHANGELOG.md`}>
      <span class="dot"></span>
      <span>Free · open source · in daily use</span>
      <span class="arrow">→</span>
    </a>

    <h1 class="reveal" style="--d:.08s">
      The job application tracker that <span class="serif grad">never leaves</span> your machine.
    </h1>

    <p class="sub reveal" style="--d:.16s">
      <span class="sr-only">Track every application, recruiter, interview round, follow-up and offer.</span>
      <span aria-hidden="true">Track every </span>
      <span class="rotate" data-rotate aria-hidden="true">
        {ROTATING.map((w, i) => (
          <span class={i === 0 ? "on" : ""}>{w}</span>
        ))}
      </span>
      <br />
      Your whole job search in one place, and a list of exactly who to follow up with today. It runs on your
      own computer: no account, no subscription, nobody watching.
    </p>

    <div class="ctas reveal" style="--d:.24s">
      <a class="btn btn-primary" href="#quickstart" data-magnetic>
        Get started, it's free <span class="arrow">→</span>
      </a>
      <a class="btn btn-ghost" href="#how" data-magnetic>
        See it in action <span class="arrow">↓</span>
      </a>
    </div>

    <ul class="trust reveal" style="--d:.32s" aria-label="Promises">
      <li>Free</li>
      <li>No sign-up</li>
      <li>No tracking or ads</li>
      <li>Your data stays on your computer</li>
      <li>Open source</li>
    </ul>
  </div>

  <div class="stage wrap" data-tilt>
    <div class="tilt">
      <div class="glow" aria-hidden="true"></div>
      <div class="browser">
        <div class="browser-bar">
          <i></i>
          <i></i>
          <i></i>
          <span>127.0.0.1:8770</span>
        </div>
        <Image
          src={shot("overview")}
          alt="The Overview page of Job Application Tracker: counts, the pipeline by stage, what needs attention and what's coming up (made-up demo data)"
          widths={[700, 1100, 1400]}
          sizes="(max-width: 1200px) 100vw, 1200px"
          loading="eager"
          fetchpriority="high"
          class="hero-shot"
        />
      </div>

      <div class="float f1" aria-hidden="true">
        <span class="badge b-pink">●</span>
        <div>
          <b>Riley Chen replied</b>
          <small>Northwind Talent · to read</small>
        </div>
      </div>
      <div class="float f2" aria-hidden="true">
        <span class="badge b-amber">⏰</span>
        <div>
          <b>3 follow-ups due</b>
          <small>Contoso, Fabrikam, Litware</small>
        </div>
      </div>
      <div class="float f3" aria-hidden="true">
        <span class="badge b-green">£</span>
        <div>
          <b>Offer to answer</b>
          <small>Worth a year: £96,400</small>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 112px;
    position: relative;
  }
  .hero-text {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 16px 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: color-mix(in oklab, var(--text) 4%, transparent);
    backdrop-filter: blur(8px);
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    transition: border-color 0.3s;
  }
  .pill:hover {
    border-color: color-mix(in oklab, var(--accent-soft) 50%, transparent);
    color: var(--text);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--green) 70%, transparent);
    animation: ping 2s infinite;
  }
  @keyframes ping {
    70% {
      box-shadow: 0 0 0 10px color-mix(in oklab, var(--green) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--green) 0%, transparent);
    }
  }
  h1 {
    font-size: clamp(42px, 7vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
    margin: 24px 0 20px;
    max-width: 1050px;
    text-wrap: balance;
  }
  h1 .serif {
    font-size: 1.08em;
    letter-spacing: -0.02em;
    padding-right: 0.06em;
  }
  .sub {
    color: var(--muted);
    font-size: clamp(17px, 1.8vw, 21px);
    max-width: 720px;
    margin: 0 0 30px;
    text-wrap: pretty;
  }
  .rotate {
    display: inline-grid;
    vertical-align: bottom;
    color: var(--text);
    font-weight: 600;
    text-align: left;
    min-width: 9.5em;
  }
  .rotate > span {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.6em);
    filter: blur(4px);
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease),
      filter 0.5s var(--ease);
  }
  .rotate > span:global(.on) {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .rotate > span:global(.off) {
    opacity: 0;
    transform: translateY(-0.6em);
  }
  .rotate > span::after {
    content: ".";
    color: var(--muted);
  }
  .ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .trust {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 22px;
    color: var(--faint);
    font-size: 14px;
  }
  .trust li::before {
    content: "✓ ";
    color: var(--green);
  }

  /* The product shot: tilted back in 3D, it straightens as you scroll to it. */
  .stage {
    margin-top: 80px;
    perspective: 1600px;
  }
  .tilt {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    transform: rotateX(calc(var(--lean, 0deg) + var(--rx))) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease);
  }
  @supports (animation-timeline: view()) {
    .tilt {
      animation: straighten linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 45%;
    }
  }
  @keyframes straighten {
    from {
      --lean: 24deg;
      scale: 0.92;
    }
    to {
      --lean: 0deg;
      scale: 1;
    }
  }
  .browser :global(.hero-shot) {
    width: 100%;
    aspect-ratio: 1400 / 860;
    object-fit: cover;
    object-position: top;
  }
  .glow {
    position: absolute;
    inset: 10% 5% -5%;
    background: radial-gradient(
      ellipse at center,
      color-mix(in oklab, var(--brand) 55%, transparent),
      color-mix(in oklab, var(--violet) 30%, transparent) 40%,
      transparent 70%
    );
    filter: blur(60px);
    z-index: -1;
    animation: breathe 6s ease-in-out infinite alternate;
  }
  @keyframes breathe {
    to {
      opacity: 0.6;
      transform: scale(1.06);
    }
  }
  .float {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 14px;
    background: color-mix(in oklab, var(--bg-2) 78%, transparent);
    border: 1px solid var(--border-strong);
    backdrop-filter: blur(14px);
    box-shadow: 0 20px 50px -10px color-mix(in oklab, var(--shadow) 70%, transparent);
    font-size: 14px;
    line-height: 1.3;
    transform: translateZ(60px);
    animation: bob 6s ease-in-out infinite;
  }
  .float b {
    display: block;
    font-weight: 600;
  }
  .float small {
    color: var(--muted);
    font-size: 12.5px;
  }
  .badge {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
  }
  .b-pink {
    background: color-mix(in oklab, var(--pink) 18%, transparent);
    color: var(--pink);
  }
  .b-amber {
    background: color-mix(in oklab, var(--amber) 15%, transparent);
  }
  .b-green {
    background: color-mix(in oklab, var(--green) 16%, transparent);
    color: var(--green);
  }
  .f1 {
    left: -3%;
    top: 18%;
  }
  .f2 {
    right: -4%;
    top: 42%;
    animation-delay: -2s;
  }
  .f3 {
    left: 6%;
    bottom: 8%;
    animation-delay: -4s;
  }
  @keyframes bob {
    50% {
      translate: 0 -12px;
    }
  }
  @media (max-width: 760px) {
    .float {
      display: none;
    }
    .stage {
      margin-top: 56px;
    }
    .hero {
      padding-top: 100px;
    }
    .rotate {
      min-width: 0;
    }
  }
  @property --lean {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }
</style>
