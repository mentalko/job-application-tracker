---
import { GUIDE, STACK } from "../data";
---

<section class="section" id="privacy" aria-labelledby="arch-h">
  <div class="wrap">
    <div class="split">
      <div>
        <p class="eyebrow reveal">Private by design</p>
        <h2 class="h2 reveal" id="arch-h">
          Your job hunt is <span class="serif grad">nobody else's</span> business.
        </h2>
        <p class="lede reveal">
          Salaries, recruiters' names, interview notes and the CV you tailored at 1am: none of it should live
          on someone else's server. Here it lives in one folder you own, in formats you can read without the
          app.
        </p>
        <ul class="points">
          <li class="reveal">
            <b>Nothing leaves your computer.</b> No account, no cloud, no tracking and no AI. It never sends
            email, contacts anyone or calls out to the web.
          </li>
          <li class="reveal">
            <b>Ordinary files.</b> Everything is saved in one folder: your notes as text files, your CVs and
            attachments as they are, and an export you can read without the app.
          </li>
          <li class="reveal">
            <b>Easy backups.</b> Download one zip of everything from the sidebar. If you use git, the folder
            keeps its own history and <code>jat push</code> copies it to your private repo.
          </li>
        </ul>
        <a class="btn btn-ghost reveal" href={`${GUIDE}your-data.md`}>
          How your data is stored <span class="arrow">→</span>
        </a>
      </div>

      <div class="diagram reveal" aria-label="How it fits together">
        <div class="box">
          <div class="machine" aria-hidden="true">
            your machine
          </div>
          <div class="node browser-node">
            <span class="k">Your browser</span>
            <b>127.0.0.1:8770</b>
            <small>React · Mantine · d3-sankey</small>
          </div>
          <div class="wire" aria-hidden="true">
            <span></span>
          </div>
          <div class="node app-node">
            <span class="k">jat serve</span>
            <b>FastAPI + SQLite</b>
            <small>Python 3.12 · run with uv</small>
          </div>
          <div class="wire" aria-hidden="true">
            <span></span>
          </div>
          <div class="node data-node">
            <span class="k">Your data folder</span>
            <b>~/job-search-data</b>
            <small>export/*.jsonl · notes/*.md · files/</small>
          </div>
        </div>
        <div class="wire dashed" aria-hidden="true">
          <span></span>
        </div>
        <div class="node git-node">
          <span class="k">jat push</span>
          <b>Your private git repo</b>
          <small>full history, off-machine</small>
        </div>
      </div>
    </div>

    <div class="stack reveal" aria-label="Built with">
      <span class="label">For developers: built with</span>
      {STACK.map((s) => (
        <span class="chip">{s}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .split .h2 {
    font-size: clamp(36px, 4.4vw, 56px);
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
  }
  .points {
    list-style: none;
    padding: 0;
    margin: 32px 0;
    display: grid;
    gap: 16px;
  }
  .points li {
    padding-left: 30px;
    position: relative;
    color: var(--muted);
  }
  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 5px;
    background: linear-gradient(135deg, var(--brand), var(--violet));
    box-shadow: 0 0 16px color-mix(in oklab, var(--brand) 70%, transparent);
  }
  .points b {
    color: var(--text);
  }
  code {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 2px 7px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text);
  }
  .diagram,
  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .box {
    position: relative;
    width: 100%;
    padding: 44px 30px 30px;
    border-radius: 28px;
    border: 1px dashed color-mix(in oklab, var(--violet) 45%, transparent);
    background: radial-gradient(
      ellipse at top,
      color-mix(in oklab, var(--brand) 12%, transparent),
      transparent 70%
    );
  }
  .machine {
    position: absolute;
    top: -12px;
    left: 30px;
    padding: 2px 12px;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid color-mix(in oklab, var(--violet) 45%, transparent);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--violet);
  }
  .node {
    width: min(360px, 100%);
    padding: 16px 20px;
    border-radius: 16px;
    border: 1px solid var(--border-strong);
    background: color-mix(in oklab, var(--bg-2) 85%, transparent);
    backdrop-filter: blur(8px);
    display: grid;
    gap: 2px;
    box-shadow: 0 20px 40px -20px color-mix(in oklab, var(--shadow) 80%, transparent);
  }
  .k {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--cyan);
  }
  .node b {
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .node small {
    color: var(--faint);
    font-size: 13px;
  }
  .git-node {
    border-color: color-mix(in oklab, var(--green) 40%, transparent);
  }
  .git-node .k {
    color: var(--green);
  }
  .wire {
    position: relative;
    width: 2px;
    height: 46px;
    background: color-mix(in oklab, var(--text) 12%, transparent);
    overflow: hidden;
  }
  .wire span {
    position: absolute;
    left: 0;
    width: 2px;
    height: 18px;
    background: linear-gradient(180deg, transparent, var(--cyan), transparent);
    animation: flow 1.6s linear infinite;
  }
  .wire:nth-of-type(4) span {
    animation-delay: 0.5s;
  }
  .wire.dashed {
    background: repeating-linear-gradient(
      180deg,
      color-mix(in oklab, var(--text) 25%, transparent) 0 4px,
      transparent 4px 8px
    );
  }
  .wire.dashed span {
    background: linear-gradient(180deg, transparent, var(--green), transparent);
    animation-delay: 1s;
  }
  @keyframes flow {
    from {
      top: -18px;
    }
    to {
      top: 46px;
    }
  }
  .stack {
    margin-top: 80px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: center;
  }
  .label {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--faint);
    margin-right: 6px;
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }
</style>
