---
import { STATS } from "../data";

// Lit word by word as you scroll (motion.ts). Words in `hot` glow in colour.
const text =
  "Recruiters pitch five roles in one call. Processes drag on for six rounds. Half the companies ghost you. And your spreadsheet has no idea who to chase today.";
const hot = new Set(["five", "six", "ghost", "chase", "today."]);
const words = text.split(" ");
---

<section class="section manifesto" aria-labelledby="problem">
  <div class="wrap">
    <p class="eyebrow reveal" id="problem">
      The problem
    </p>
    <p class="words" data-words>
      {words.map((w) => (
        <span class={`w ${hot.has(w) ? "hot" : ""}`}>{w} </span>
      ))}
    </p>
    <p class="answer reveal">
      So here's a <span class="serif grad">CRM for your job hunt.</span>
    </p>

    <dl class="stats">
      {STATS.map((s, i) => (
        <div class="stat reveal" style={`--d:${i * 0.08}s`}>
          <dt>{s.label}</dt>
          <dd>
            <span data-count={s.value} data-suffix={s.suffix}>
              {s.value}
              {s.suffix}
            </span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .words {
    font-size: clamp(32px, 5vw, 64px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 650;
    margin: 0;
    max-width: 1100px;
  }
  :global(.js) .w {
    color: rgb(255 255 255 / 0.13);
    transition: color 0.35s;
  }
  :global(.js) .w:global(.lit) {
    color: var(--text);
  }
  :global(.js) .w.hot:global(.lit) {
    color: #ffa8c5;
    text-shadow: 0 0 30px rgb(240 101 149 / 0.5);
  }
  .answer {
    margin: 40px 0 0;
    font-size: clamp(32px, 5vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 650;
  }
  .stats {
    margin: 100px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--border);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    padding: 34px 28px;
    background: var(--bg-2);
  }
  dd {
    margin: 0;
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(180deg, #fff, #8e94b8);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }
  dt {
    margin-top: 10px;
    color: var(--muted);
    font-size: 15px;
  }
  @media (max-width: 760px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
