---
import { FAQ } from "../data";

// `code` in answers becomes <code>. The same answers feed the FAQPage JSON-LD (Landing.astro).
const html = (a: string) =>
  a
    .replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!)
    .replace(/`([^`]+)`/g, "<code>$1</code>");
---

<section class="section" id="faq" aria-labelledby="faq-h">
  <div class="wrap faq">
    <div>
      <p class="eyebrow reveal">FAQ</p>
      <h2 class="h2 reveal" id="faq-h">
        Questions, <span class="serif grad">answered</span>.
      </h2>
      <p class="lede reveal">
        Anything else? Ask in an issue: there are no silly questions about job hunting.
      </p>
    </div>
    <div class="list">
      {FAQ.map((f, i) => (
        <details class="reveal" style={`--d:${i * 0.04}s`} name="faq">
          <summary>
            <span>{f.q}</span>
            <span class="plus" aria-hidden="true" />
          </summary>
          <p set:html={html(f.a)} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 60px;
    align-items: start;
  }
  .faq > div:first-child {
    position: sticky;
    top: 110px;
  }
  .list {
    display: grid;
    gap: 12px;
  }
  details {
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition:
      border-color 0.3s,
      background 0.3s;
    interpolate-size: allow-keywords;
  }
  details[open] {
    border-color: color-mix(in oklab, var(--violet) 45%, transparent);
    background: color-mix(in oklab, var(--violet) 6%, transparent);
  }
  details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.4s var(--ease),
      content-visibility 0.4s allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 17.5px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    inset: 6px 0 auto;
    height: 2px;
    border-radius: 2px;
    background: var(--muted);
    transition: transform 0.4s var(--ease);
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus::after {
    transform: rotate(0deg);
  }
  details p {
    margin: 0;
    padding: 0 24px 22px;
    color: var(--muted);
  }
  details p :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text);
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .faq > div:first-child {
      position: static;
    }
  }
</style>
