---
import { Image } from "astro:assets";
import { shot } from "../shots";

// The everyday loop, step by step. The picture on the right sticks and swaps as you scroll.
const steps = [
  {
    img: "overview",
    when: "08:55",
    title: "Coffee. Open the Overview.",
    body: "What's active, what needs attention, who you're waiting on and what's coming up today, before you've finished the first sip.",
    alt: "The Overview page",
  },
  {
    img: "person",
    when: "10:30",
    title: "A recruiter calls with three roles.",
    body: "Log the call against them, add each role they mentioned, and book the follow-up with an agenda.",
    alt: "A recruiter's page with calls and the roles they pitched",
  },
  {
    img: "role",
    when: "11:15",
    title: "Apply, or pass with a reason.",
    body: "Each role gets a page. Drop the job description on it: it follows the role onto your application.",
    alt: "A role's page with pay, the recruiter, notes and the job description",
  },
  {
    img: "application",
    when: "14:00",
    title: "Round 3: system design.",
    body: "Interview rounds in your own words, prep and debrief notes, the CV you sent and the full history, all in one place.",
    alt: "An application's page with interview rounds, notes, links and files",
  },
  {
    img: "next-actions",
    when: "17:40",
    title: "Chase, snooze, or call it ghosted.",
    body: "Next actions lists who to follow up with. One click each, then close the laptop.",
    alt: "The Next actions page",
  },
  {
    img: "insights-stats",
    when: "Friday",
    title: "Look back at the week.",
    body: "Conversion per stage, time in stage, direct vs recruiter outcomes and a scorecard for every recruiter.",
    alt: "Conversion, time in stage and a recruiter scorecard",
  },
];
---

<section class="section" id="how" aria-labelledby="how-h">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow reveal">How it works</p>
      <h2 class="h2 reveal" id="how-h">A day in your <span class="serif grad">job hunt</span>.</h2>
    </div>

    <div class="show" data-showcase>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class={`step ${i === 0 ? "active" : ""}`} data-step={i}>
              <span class="when">{s.when}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <div class="inline-pic">
                <Image src={shot(s.img)} alt={s.alt} widths={[600, 900]} sizes="100vw" class="shot" />
              </div>
            </li>
          ))
        }
      </ol>
      <div class="sticky" aria-hidden="true">
        <div class="frame browser">
          <div class="browser-bar"><i></i><i></i><i></i><span>127.0.0.1:8770</span></div>
          <div class="pics">
            {
              steps.map((s, i) => (
                <div class={`pic ${i === 0 ? "active" : ""}`} data-pic={i}>
                  <Image src={shot(s.img)} alt="" widths={[700, 1100, 1400]} sizes="700px" />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: 40px;
  }
  .show {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 60px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 28px;
    border-left: 2px solid var(--border);
    opacity: 0.3;
    transition:
      opacity 0.5s,
      border-color 0.5s;
  }
  .step:global(.active) {
    opacity: 1;
    border-color: var(--violet);
  }
  .when {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--cyan);
    margin-bottom: 10px;
  }
  h3 {
    margin: 0 0 12px;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 650;
  }
  .step p {
    margin: 0;
    color: var(--muted);
    font-size: 18px;
    max-width: 440px;
  }
  .sticky {
    position: sticky;
    top: calc(50vh - 260px);
    height: 520px;
    align-self: start;
  }
  .frame {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .pics {
    position: relative;
    flex: 1;
    background: #fff;
  }
  .pic {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.03);
    filter: blur(8px);
    transition:
      opacity 0.7s var(--ease),
      transform 0.9s var(--ease),
      filter 0.7s var(--ease);
  }
  .pic:global(.active) {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }
  .inline-pic {
    display: none;
  }
  @media (max-width: 900px) {
    .show {
      grid-template-columns: 1fr;
    }
    .sticky {
      display: none;
    }
    .step {
      min-height: 0;
      padding-block: 28px;
      opacity: 1;
    }
    .inline-pic {
      display: block;
      margin-top: 22px;
      max-height: 340px;
      overflow: hidden;
      border-radius: 12px;
    }
  }
</style>
